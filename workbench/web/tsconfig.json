{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [
    "src/views/CompareView.tsx",
    "src/views/DatasetView.tsx",
    "src/views/GeneratorsView.tsx",
    "src/views/SliceView.tsx"
  ]
}
